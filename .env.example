# === Autonomous Blog Agent — Environment Variables ===

# Google Gemini (required — powers all LLM calls on the free tier,
# and is also the image-generation fallback).
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_key_here

# Tavily (required for web research)
TAVILY_API_KEY=your_key_here

# OpenAI (optional — only needed for LLM_PROVIDER=openai,
# and for image generation, which prefers OpenAI when a key is present)
OPENAI_API_KEY=

# LLM provider: "google" (free, default) or "openai" (paid)
# LLM_PROVIDER=google

# Every Gemini Flash model allows only 20 requests/day free, but each has its
# OWN 20 — so the main tier walks a pool as each one runs dry (~8 posts/day).
# Set LLM_MODEL to pin one model and disable rotation.
# LLM_MODEL_POOL=gemini-3-flash-preview,gemini-3.6-flash,gemini-flash-latest
# LLM_MODEL_LIGHT=gemini-flash-lite-latest   # router / research / SEO
# SECTIONS_PER_POST=7
# LLM_MODEL=

# Client-side throttle in requests/minute, shared across the parallel writers.
# 0 disables it. Defaults: google -> 4, openai -> 0.
# gemini-flash-latest (= gemini-3.7-flash) allows only 5 RPM / 20 RPD on the
# free tier, so 4 keeps a run from 429-cascading. Raise to ~10 with flash-lite.
# LLM_REQUESTS_PER_MINUTE=4

# Retries on transient errors such as 429 (default: 5)
# LLM_MAX_RETRIES=5

# Image generation (optional)
# Cloudflare Workers AI — FREE image generation, the default image backend.
# 10,000 neurons/day. Default model flux-2-klein-4b (~9s, good labels).
#   flux-2-dev     = perfect labels but ~3,000 neurons => only ~3 images/day
#   flux-1-schnell = fastest/cheapest but garbles labels
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
# Account ID: dash.cloudflare.com -> Workers & Pages (right sidebar)
# Token:      dash.cloudflare.com/profile/api-tokens -> "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenRouter — paid image fallback (~$0.068/image). Optional.
OPENROUTER_API_KEY=

# How visuals are rendered: auto (default) | mermaid | image
#   auto    - Mermaid for structural diagrams (free), images for pictures
#   mermaid - Mermaid only, costs nothing
#   image   - always use the image backend
# DIAGRAM_MODE=auto

# Image backend for pictorial visuals:
# cloudflare (default, FREE ~200 images/day) | openrouter (~$0.068/image,
# prepaid) | pollinations (free, poor labels) | openai | gemini (paid) | none
# IMAGE_PROVIDER=openrouter
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# Max images per post (default: 5)
# MAX_IMAGES=5
# Gemini fallback model — must be image-capable (default: gemini-3.1-flash-image)
# IMAGE_MODEL=gemini-3.1-flash-image

# Output directory (optional, defaults to "output")
# OUTPUT_DIR=output

# Citation verification: report (default) | strip | off
# CITATION_POLICY=report

# Publishing (optional)
DEVTO_API_KEY=your_devto_api_key
